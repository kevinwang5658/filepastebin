{
  "name": "filepastebin",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "clean": "rimraf dist && rimraf src/client/node_modules && rimraf node_modules",
    "build": "gulp build-prod",
    "build:pages": "gulp build-pages",
    "dev:worker": "wrangler dev",
    "dev:pages": "npx serve dist/pages --single --listen 3000",
    "deploy:worker": "wrangler deploy",
    "postinstall": "cd src/client && npm install"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@types/node": "^17.0.25",
    "@typescript-eslint/eslint-plugin": "^5.19.0",
    "@typescript-eslint/parser": "^5.19.0",
    "del": "^3.0.0",
    "eslint": "^8.13.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-react": "^7.29.4",
    "gulp": "^4.0.2",
    "gulp-hub": "^4.2.0",
    "gulp-watch": "^5.0.1",
    "typescript": "~4.6.3",
    "watch": "^1.0.2",
    "wrangler": "^3.0.0"
  }
}
